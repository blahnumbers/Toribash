# Extra limbs example: a three-segment tail (Toribash 5.78+)
# Older clients load this as classic: "env_obj 0" makes them skip everything after it.

env_obj 0

body tail1
shape box
sides 0.08 0.16 0.08
pos 1.0 1.20 1.48
color 0.55 0.35 0.2
density 1.5

body tail2
shape box
sides 0.07 0.16 0.07
pos 1.0 1.36 1.44
color 0.55 0.35 0.2
density 1.5

body tail3
shape box
sides 0.06 0.16 0.06
pos 1.0 1.52 1.40
color 0.45 0.28 0.15
density 1.5

joint tail_base
connect groin tail1
pos 1.0 1.11 1.50
axis 1 0 0
radius 0.07
range 0.8 -0.8
strength 2
velocity 10

joint tail_mid
connect tail1 tail2
pos 1.0 1.28 1.46
axis 1 0 0
radius 0.06
range 0.8 -0.8
strength 1.5
velocity 10

joint tail_tip
connect tail2 tail3
pos 1.0 1.44 1.42
axis 0 0 1
radius 0.05
range 0.8 -0.8
strength 1
velocity 10

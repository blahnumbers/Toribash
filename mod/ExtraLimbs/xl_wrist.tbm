# Extra limbs example: an extra segment between the right forearm and hand (Toribash 5.78+)
# Classic parts that move come first; the extra limbs follow "env_obj 0".

body r_hand
pos -0.6 0.85 2.3
joint r_wrist
pos -0.47 0.9 2.3
connect r_hand r_seg

env_obj 0

body r_seg
shape box
sides 0.2 0.1 0.1
pos -0.33 0.9 2.3
color 0.9 0.8 0.6

joint r_wrist2
connect r_triceps r_seg
pos -0.2 0.9 2.3
axis 0 0 1
radius 0.09
range 1.2 -1.2
strength 2
velocity 30
